PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/housecare?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Admin configuration
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@housecare.com
DEMO_ADMIN_PASSWORD=your_strong_admin_password

# Email configuration (Optional - for OTP password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=HouseCare <noreply@housecare.com>

# Razorpay configuration (Optional - for live payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
